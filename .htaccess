# ============================================================
#  STRONG PERFORMANCE CENTRO AUTOMOTIVO
#  .htaccess — Apache Server Security & Performance
#  strongperformance.com.br
# ============================================================

# ─── ENGINE ───
Options -Indexes -MultiViews
Options +FollowSymLinks

# ─── SECURITY HEADERS ───
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — restrict dangerous APIs
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=()"

    # HSTS — Force HTTPS (enable after SSL is active)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdnjs.cloudflare.com https://unpkg.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; frame-src https://www.google.com; connect-src 'self' https: blob:;"

    # Remove server signature
    Header always unset X-Powered-By
    Header always unset Server

    # Prevent caching of sensitive files
    <FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|conf|env)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ─── BLOCK ACCESS TO SENSITIVE FILES ───
<FilesMatch "(\.htaccess|\.htpasswd|\.env|\.git|\.svn|\.DS_Store|Thumbs\.db|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|wp-config\.php)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to hidden directories
RedirectMatch 403 /\\.

# ─── HOTLINK PROTECTION ───
# Prevent other sites from embedding your images
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?strongperformance\.com\.br [NC]
    RewriteCond %{HTTP_REFERER} !^https?://localhost [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico)$ - [F,L]
</IfModule>

# ─── BLOCK BAD BOTS & SCRAPERS ───
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block common bad bots by user-agent
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|Python-urllib|curl|scrapy|HTTrack|WebZIP|SiteSucker|WebCopier|Offline|MSFrontPage) [NC]
    RewriteRule .* - [F,L]

    # Block empty user-agents (often bots)
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule .* - [F,L]

    # Block SQL injection patterns in URLs
    RewriteCond %{QUERY_STRING} (union.*select|select.*from|insert.*into|drop.*table|1=1|or%201=1|benchmark\(|sleep\() [NC,OR]
    RewriteCond %{QUERY_STRING} (javascript:|vbscript:|<script|%3cscript) [NC]
    RewriteRule .* - [F,L]

    # Block XSS patterns
    RewriteCond %{QUERY_STRING} (<|>|%3C|%3E) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ─── RATE LIMITING (requires mod_evasive) ───
# <IfModule mod_evasive24.c>
#     DOSHashTableSize    3097
#     DOSPageCount        5
#     DOSSiteCount        50
#     DOSPageInterval     1
#     DOSSiteInterval     1
